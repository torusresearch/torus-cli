{
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": "git@github.com:torusresearch/torus-cli.git",
  "scripts": {
    "build": "vp run -r --fail-if-no-match build",
    "check": "vp check",
    "typecheck": "tsc --noEmit -p packages/torus-scripts/tsconfig.json && tsc --noEmit -p packages/oxlint-config-typescript/tsconfig.json && tsc --noEmit -p packages/oxlint-config-react/tsconfig.json && tsc --noEmit -p packages/oxlint-config-vue/tsconfig.json && tsc --noEmit -p packages/oxlint-config-node/tsconfig.json",
    "test": "vp test",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish",
    "check:styles": "vp fmt --check .",
    "fix:styles": "vp fmt --write ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@types/node": "^24.13.6",
    "oxlint-plugin-vize": "^0.645.0",
    "oxlint-tailwindcss": "^1.17.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {}
}
