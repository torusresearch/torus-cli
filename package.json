{
  "private": true,
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": "git@github.com:torusresearch/torus-cli.git",
  "scripts": {
    "build": "vp run -r build --fail-if-no-match",
    "check": "vp check",
    "test": "vp test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "changeset publish",
    "check:styles": "prettier --check .",
    "fix:styles": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "vite-plus": "1.3.0",
    "@changesets/cli": "3.0.3",
    "@lavamoat/harden": "0.8.1"
  },
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {}
}
