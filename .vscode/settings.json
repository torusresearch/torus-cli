{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "cSpell.words": [
    "arbitrum",
    "autoclean",
    "browserslist",
    "cdpath",
    "customauth",
    "customizer",
    "oxcconfig",
    "gitattributes",
    "gitlab",
    "hgcheck",
    "hgignore",
    "intellij",
    "listr",
    "mergewith",
    "mkdocs",
    "npmignore",
    "opencollective",
    "openlogin",
    "passwordless",
    "relocator",
    "repos",
    "serviceworker",
    "solana",
    "toruslabs",
    "vercel",
    "wordmark",
    "yarnpkg"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}
