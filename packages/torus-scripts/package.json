{
  "name": "@toruslabs/torus-scripts",
  "version": "8.1.0",
  "type": "module",
  "description": "Scripts for Torus libraries to manage bundling, lint etc",
  "bin": {
    "torus-scripts-upgrade": "./dist/migrate/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack"
  },
  "exports": {
    "./library": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./lint": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./fmt": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue-lint": {
      "types": "./dist/vue-lint.d.mts",
      "import": "./dist/vue-lint.mjs"
    }
  },
  "peerDependencies": {
    "oxlint-plugin-vize": "^0.485.0",
    "oxlint-tailwindcss": "^1.14.0",
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-plugin-vize": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/torusresearch/torus-cli/issues"
  },
  "homepage": "https://github.com/torusresearch/torus-cli/tree/main/packages/torus-scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/torus-cli.git"
  }
}
